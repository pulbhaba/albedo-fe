# Leave VUE_APP_API_URL empty for local development so Vue's dev-server proxy
# forwards /oauth2, /public, /user, and /actuator to the backend.
VUE_APP_API_URL=
VUE_APP_BACKEND_PROXY_TARGET=http://localhost:8080
VUE_APP_CLIENT_ID=albedo-client
VUE_APP_CLIENT_SECRET=albedo-secret
# Leave empty to proxy novel-service requests locally; set this when the novel
# service is hosted separately from the auth backend.
VUE_APP_NOVEL_SERVICE_API_URL=
