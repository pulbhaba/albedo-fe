# Leave the API URL variables empty for local development so Vue's dev-server
# proxy forwards auth requests to the auth service and novel/library requests
# to the novels service.
VUE_AUTH_API_URL=
VUE_NOVELS_API_URL=
VUE_AUTH_PROXY_TARGET=http://localhost:8080
VUE_NOVELS_PROXY_TARGET=http://localhost:8000
VUE_APP_CLIENT_ID=albedo-client
VUE_APP_CLIENT_SECRET=albedo-secret
